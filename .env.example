# Never put real passwords or API keys in this file.

# Database connection (used by Python/backend)
DATABASE_URL=

# Public frontend Supabase settings
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Private server-side database credential
SUPABASE_SERVICE_ROLE_KEY=
EOF
